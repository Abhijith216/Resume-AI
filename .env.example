# API key for the LLM provider (OpenAI, Gemini, Anthropic, etc.)
LLM_API_KEY=your_api_key_here

# Optional: Provider ('openai', 'gemini', 'anthropic'). Auto-detected if omitted based on key prefix.
# LLM_PROVIDER=openai

# Optional: Specific model name (e.g. gpt-4o-mini, gemini-1.5-flash, claude-3-5-haiku-20241022)
# LLM_MODEL=gpt-4o-mini

# Optional: Custom base URL for OpenAI-compatible providers (Groq, Ollama, OpenRouter, etc.)
# LLM_BASE_URL=https://api.openai.com/v1

# For local AI without a provider API quota, install Ollama and pull a compatible model.
# Then configure LLM_PROVIDER=openai, LLM_BASE_URL=http://localhost:11434/v1,
# LLM_MODEL=<model-name>, and LLM_API_KEY=ollama in your local .env.local.

# Port the server listens on (defaults to 3000 if not set)
PORT=3000
